<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      §7.3 — the foreground service is what makes nhztermd exempt from the
      Android 12+ phantom-process-killer BY CONSTRUCTION. The notification is
      not polish; omitting it means Android kills the service.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 13+: without this the persistent notification is silently dropped. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- §8 — opt-in, OFF by default. CPU-awake during long builds only. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Permission an EXTERNAL client (Valence Studio) must hold to bind the
      daemon (§7.1). signature-level so only apps signed with the same key
      qualify; the token handshake (§13) is the second, independent gate.
    -->
    <permission
        android:name="tech.nhz.nhzterm.permission.BIND_DAEMON"
        android:protectionLevel="signature" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nhzterm">

        <activity
            android:name=".ui.TerminalActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|density"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".daemon.NhztermdService"
            android:exported="true"
            android:permission="tech.nhz.nhzterm.permission.BIND_DAEMON"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Hosts persistent user-initiated terminal (PTY) sessions and long-running shell processes that must survive UI detachment." />
        </service>

    </application>
</manifest>
